# Untuk Anthropic, gunakan endpoint persis seperti contoh CURL.
# Untuk provider OpenAI-compatible, gunakan URL dasar provider tersebut.
OPENAI_BASE_URL=https://agentrouter.org/v1

# Buat atau salin API key dari dashboard OpenAI Anda.
OPENAI_API_KEY=masukkan_api_key_di_sini

# Gunakan ID model yang tersedia untuk akun OpenAI Anda.
OPENAI_MODEL=gpt-4o-mini

# Alternatif eksplisit untuk Anthropic (mengalahkan OPENAI_* jika diisi):
# ANTHROPIC_BASE_URL=https://ai.bluepack.my.id/messages
# ANTHROPIC_API_KEY=masukkan_api_key_anthropic_di_sini
# ANTHROPIC_MODEL=claude-opus-5

PORT=3000
