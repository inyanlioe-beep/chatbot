# Untuk Bluepack, gunakan endpoint persis seperti contoh CURL.
# Untuk provider OpenAI-compatible, gunakan URL dasar provider tersebut.
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Buat atau salin API key dari dashboard AgentRouter Anda.
AGENTROUTER_API_KEY=masukkan_api_key_di_sini

# Gunakan ID model yang tersedia untuk akun AgentRouter Anda.
AGENTROUTER_MODEL=gpt-4o-mini

# Alternatif eksplisit untuk Bluepack (mengalahkan AGENTROUTER_* jika diisi):
# BLUEPACK_BASE_URL=https://ai.bluepack.my.id/messages
# BLUEPACK_API_KEY=masukkan_api_key_bluepack_di_sini
# BLUEPACK_MODEL=claude-opus-5

PORT=3000
