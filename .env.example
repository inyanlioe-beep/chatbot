# URL dasar API OpenAI-compatible milik AgentRouter.
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# Buat atau salin API key dari dashboard AgentRouter Anda.
AGENTROUTER_API_KEY=masukkan_api_key_di_sini

# Gunakan ID model yang tersedia untuk akun AgentRouter Anda.
AGENTROUTER_MODEL=gpt-4o-mini

PORT=3000
